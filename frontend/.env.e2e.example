# `seed_e2e_auth_accounts`가 만드는 테스트 전용 계정입니다. 실제 직원 계정은 사용하지 마세요.
E2E_EMPLOYEE_EMAIL=e2e-employee@msflowhub.test
E2E_EMPLOYEE_PASSWORD=
E2E_SUPER_ADMIN_EMAIL=e2e-super-admin@msflowhub.test
E2E_SUPER_ADMIN_PASSWORD=
E2E_SUPER_ADMIN_EMPLOYEE_ID=emp-e2e-super-admin

# 비밀번호 변경 검증은 일반 직원 E2E 계정에서만 실행하며, 변경 후 현재 비밀번호로 되돌립니다.
E2E_PASSWORD_CHANGE_NEW_PASSWORD=

# 기본값은 http://127.0.0.1:3000 입니다.
E2E_BASE_URL=http://127.0.0.1:3000
