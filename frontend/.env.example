# Leave empty for the local Next.js proxy. Set only when FastAPI is hosted separately.
NEXT_PUBLIC_API_BASE_URL=

# Optional local proxy target. Defaults to http://127.0.0.1:8000.
BACKEND_URL=

# Supabase Auth browser client. Copy these values from Supabase Project Settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
