# Frontend API: leave empty to use the local Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=

# Frontend proxy: optional local FastAPI target. Defaults to http://127.0.0.1:8000.
BACKEND_URL=

# Supabase Auth browser client: these public values are safe to expose in browser bundles.
# Never place SUPABASE_SECRET_KEY or database URLs in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auto-logout: minutes the site may stay closed before the session is signed out.
# Keeping a tab open holds the session; the clock only runs while no tab is open.
# Leave empty to use the default (30).
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=
