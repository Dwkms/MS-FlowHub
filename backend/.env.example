# Supabase PostgreSQL application connection string.
# Example format: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Leave empty to use the persistent local SQLite development database.
DATABASE_URL=

# Direct database connection used only by Alembic migrations.
MIGRATION_DATABASE_URL=

# mock is the safe default when no external AI configuration exists.
AI_PROVIDER=mock

# Required only when a real AI provider is enabled. Never commit the real value.
AI_API_KEY=

# Model name for a future real AI provider.
AI_MODEL=

# Percentage. Values greater than this require approval.
DISCOUNT_APPROVAL_THRESHOLD=10

# Allowed Next.js development origin.
FRONTEND_ORIGIN=http://localhost:3000
