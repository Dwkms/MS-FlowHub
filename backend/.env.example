# Database: Supabase PostgreSQL only. Copy the application URI from Supabase Connect.
# `postgresql://` is converted to the Psycopg 3 SQLAlchemy URI automatically.
# Do not add `pgbouncer=true` to the application connection URL.
DATABASE_URL=

# Database: direct connection used only by Alembic migrations. Optional when DATABASE_URL is usable.
MIGRATION_DATABASE_URL=

# Supabase Auth: server-side values. SUPABASE_SECRET_KEY must never be exposed to Frontend code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Auth seed: development/test-only initial passwords. Never write real values to source code or logs.
AUTH_SEED_DEFAULT_PASSWORD=
E2E_AUTH_EMPLOYEE_PASSWORD=
E2E_AUTH_SUPER_ADMIN_PASSWORD=

# Application
FRONTEND_ORIGIN=http://localhost:3000
DISCOUNT_APPROVAL_THRESHOLD=10

# AI: mock is the default and needs no key. Set AI_PROVIDER=claude to call the real API.
# A missing key with AI_PROVIDER=claude is a configuration error, not a silent fallback to mock.
AI_PROVIDER=mock
AI_API_KEY=
# Defaults to claude-opus-5 when empty.
AI_MODEL=

# AI cost guards. Output tokens cost ~5x input, so AI_MAX_TOKENS is the per-call ceiling.
AI_MAX_TOKENS=8000
AI_TIMEOUT_SECONDS=15
# Rolling 24-hour call limits. Normal use is 1-2 calls per person per day.
# The global limit is the real safeguard: a per-user limit alone multiplies by account count.
AI_DAILY_LIMIT_PER_USER=5
AI_DAILY_LIMIT_GLOBAL=30
