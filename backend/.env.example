# Database: Supabase PostgreSQL only. Copy the application URI from Supabase Connect.
# `postgresql://` is converted to the Psycopg 3 SQLAlchemy URI automatically.
# Do not add `pgbouncer=true` to the application connection URL.
DATABASE_URL=

# Database: direct connection used only by Alembic migrations. Optional when DATABASE_URL is usable.
MIGRATION_DATABASE_URL=

# Supabase Auth: server-side values. SUPABASE_SECRET_KEY must never be exposed to Frontend code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Auth seed: development/test-only initial passwords. Never write real values to source code or logs.
AUTH_SEED_DEFAULT_PASSWORD=
E2E_AUTH_EMPLOYEE_PASSWORD=
E2E_AUTH_SUPER_ADMIN_PASSWORD=

# Application
FRONTEND_ORIGIN=http://localhost:3000
DISCOUNT_APPROVAL_THRESHOLD=10

# AI: mock is the default. The API key is required only when a real provider is enabled.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
